


# ===============================
# FORCE CLEAN URLs (NO .php / .html)
# ===============================

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# --------------------------------
# 1. Redirect .php and .html to clean URLs (GET only to preserve POST bodies)
# --------------------------------
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.+?)\.(php|html?)\s [NC]
RewriteRule ^ %1 [R=301,L]

# --------------------------------
# 2. Internally map clean URLs to PHP
# --------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# --------------------------------
# 3. Fallback to HTML if PHP doesn't exist
# --------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
